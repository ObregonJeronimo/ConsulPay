rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    //  Helpers
    // ============================================================
    function estaAutenticado() {
      return request.auth != null;
    }

    function miUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function tengoDoc() {
      return estaAutenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function esSuperadmin() {
      return tengoDoc() && miUsuario().rol == 'superadmin';
    }

    function esAdmin() {
      return tengoDoc() && miUsuario().rol == 'admin';
    }

    function esProfesional() {
      return tengoDoc() && miUsuario().rol == 'profesional';
    }

    function esAdminDe(consultorioIdDelRecurso) {
      return esAdmin()
        && miUsuario().consultorioId == consultorioIdDelRecurso
        && request.auth.uid in get(/databases/$(database)/documents/consultorios/$(consultorioIdDelRecurso)).data.adminUids;
    }

    function esProfesionalDe(consultorioIdDelRecurso) {
      return esProfesional() && miUsuario().consultorioId == consultorioIdDelRecurso;
    }

    function esDueno(uid) {
      return estaAutenticado() && request.auth.uid == uid;
    }

    function intentaEscalarPrivilegios() {
      return request.resource.data.rol != resource.data.rol
        || request.resource.data.consultorioId != resource.data.consultorioId;
    }

    /**
     * Compara un campo del recurso request vs resource. Si el campo NO existe
     * en el resource, considera que el request tampoco debe definirlo (o que
     * sea null). Este helper sirve para campos opcionales nuevos como
     * comisionFree, comisionPro, puedeVerPlanPro — que pueden no estar en
     * docs viejos.
     *
     * Uso: campoNoCambia('comisionFree')  ->  el admin no puede modificarlo
     */
    function campoNoCambia(name) {
      // Si NINGUNO de los dos lo tiene, OK.
      // Si AMBOS lo tienen, deben ser iguales.
      // Si solo uno lo tiene, NO permitir el cambio (cambio implicito).
      return (
        (!(name in request.resource.data) && !(name in resource.data))
        || (name in request.resource.data && name in resource.data
            && request.resource.data[name] == resource.data[name])
      );
    }

    // ============================================================
    //  /usuarios/{uid}
    // ============================================================
    match /usuarios/{uid} {

      allow read: if esSuperadmin()
        || esDueno(uid)
        || (esAdmin() && resource.data.consultorioId == miUsuario().consultorioId);

      allow create: if esDueno(uid)
        && request.resource.data.rol == 'profesional'
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.consultorioId == null;

      allow update: if esSuperadmin()
        || (esAdmin()
            && resource.data.consultorioId == miUsuario().consultorioId
            && request.resource.data.rol == resource.data.rol
            && request.resource.data.consultorioId == resource.data.consultorioId)
        || (esDueno(uid)
            && !intentaEscalarPrivilegios()
            && request.resource.data.estado == resource.data.estado)
        || (esDueno(uid)
            && !intentaEscalarPrivilegios()
            && resource.data.estado == 'activo'
            && request.resource.data.estado == 'retirado')
        || (esDueno(uid)
            && resource.data.rol == 'profesional'
            && resource.data.consultorioId == null
            && request.resource.data.rol == 'admin'
            && request.resource.data.consultorioId != null
            && request.resource.data.estado == 'activo')
        || (esDueno(uid)
            && resource.data.rol == 'profesional'
            && resource.data.consultorioId == null
            && request.resource.data.rol == 'profesional'
            && request.resource.data.consultorioId != null
            && request.resource.data.estado == 'activo');

      allow delete: if esSuperadmin();
    }

    // ============================================================
    //  /consultorios/{consultorioId}
    // ============================================================
    match /consultorios/{consultorioId} {

      allow read: if esSuperadmin()
        || (esAdmin() && miUsuario().consultorioId == consultorioId)
        || (esProfesional() && miUsuario().consultorioId == consultorioId);

      allow create: if estaAutenticado()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.adminUids == [request.auth.uid]
        && request.resource.data.plan == 'free'
        && request.resource.data.estado == 'activo';

      /*
        Update del consultorio. Casos validos:

        1. SUPERADMIN — puede tocar cualquier cosa.

        2. ADMIN del consultorio — puede:
           a. Editar campos basicos (nombre, direccion, metodos de pago,
              CBU, etc.) sin tocar campos sensibles ni admins.
           b. Modificar el array adminUids (agregar nuevos admins o
              remover existentes), siempre que:
              - El ownerUid se mantenga sin cambios (transferencia
                de ownership es un caso separado).
              - El nuevo adminUids siga conteniendo al ownerUid.
              - El nuevo adminUids no quede vacio.

        3. OWNER del consultorio (ownerUid actual) — ademas de lo anterior,
           puede transferir ownership cambiando ownerUid, siempre que el
           nuevo owner este en el adminUids resultante.

        Campos siempre blindados (solo superadmin / backend los toca):
           - plan, planVenceEn
           - comisionConsulpay (legacy, mantener para backwards compat)
           - comisionFree, comisionPro (nuevos, controlados por superadmin)
           - puedeVerPlanPro (controla si pueden contratar Plan Pro)
           - mpIntegrado, mpConfig, ualaIntegrado, ualaConfig
           - mpConfigs (NUEVO: slots primary/secondary, escrito por backend)
           - repartoActivado, repartoIniciaEn, repartoActivadoEn
             (NUEVO: estado del reparto multi-admin, controlado por backend)
           - estado
           - subscription (escrito por backend cuando se contrata/cancela Pro)
      */
      allow update: if esSuperadmin()
        || (esAdminDe(consultorioId)
            // Campos siempre blindados
            && request.resource.data.plan == resource.data.plan
            && request.resource.data.planVenceEn == resource.data.planVenceEn
            && request.resource.data.comisionConsulpay == resource.data.comisionConsulpay
            // Campos opcionales nuevos: usar campoNoCambia para soportar
            // docs viejos que pueden no tenerlos definidos
            && campoNoCambia('comisionFree')
            && campoNoCambia('comisionPro')
            && campoNoCambia('puedeVerPlanPro')
            && campoNoCambia('subscription')
            // Campos del nuevo modelo de reparto multi-admin
            // (escritos solo por backend via Admin SDK, que bypassea rules)
            && campoNoCambia('mpConfigs')
            && campoNoCambia('repartoActivado')
            && campoNoCambia('repartoIniciaEn')
            && campoNoCambia('repartoActivadoEn')
            && request.resource.data.mpIntegrado == resource.data.mpIntegrado
            && request.resource.data.mpConfig == resource.data.mpConfig
            && request.resource.data.ualaIntegrado == resource.data.ualaIntegrado
            && request.resource.data.ualaConfig == resource.data.ualaConfig
            && request.resource.data.estado == resource.data.estado
            // Reglas sobre owner y admins:
            //   - ownerUid siempre debe estar en adminUids
            //   - adminUids no puede quedar vacio (>= 1)
            //   - adminUids no puede tener mas de 2 admins (limite duro
            //     del flow de "reparto entre socias" — ver src/lib/admins.js
            //     constante MAX_ADMINS_POR_CONSULTORIO)
            //   - El owner actual puede ser cambiado solo si el caller
            //     es el owner viejo (transferencia de ownership)
            && (
              (request.resource.data.ownerUid == resource.data.ownerUid
                && request.resource.data.ownerUid in request.resource.data.adminUids
                && request.resource.data.adminUids.size() >= 1
                && request.resource.data.adminUids.size() <= 2)
              ||
              (resource.data.ownerUid == request.auth.uid
                && request.resource.data.ownerUid in request.resource.data.adminUids
                && request.resource.data.adminUids.size() >= 1
                && request.resource.data.adminUids.size() <= 2)
            ));

      allow delete: if esSuperadmin();
    }

    // ============================================================
    //  /invitaciones_profesional/{invitacionId}
    // ============================================================
    match /invitaciones_profesional/{invitacionId} {

      allow read: if true;

      allow create: if false;

      allow update: if esSuperadmin()
        || esAdminDe(resource.data.consultorioId)
        || (estaAutenticado()
            && request.auth.token.email == resource.data.email
            && request.resource.data.estado == 'aceptada');

      allow delete: if esSuperadmin() || esAdminDe(resource.data.consultorioId);
    }

    // ============================================================
    //  /pacientes/{pacienteId}
    // ============================================================
    match /pacientes/{pacienteId} {
      allow read: if esSuperadmin()
        || esAdminDe(resource.data.consultorioId)
        || (esProfesionalDe(resource.data.consultorioId)
            && request.auth.uid in resource.data.profesionalesUids);

      allow create: if esSuperadmin()
        || esAdminDe(request.resource.data.consultorioId);

      allow update: if (esSuperadmin() || esAdminDe(resource.data.consultorioId))
        && request.resource.data.consultorioId == resource.data.consultorioId;

      allow delete: if esSuperadmin() || esAdminDe(resource.data.consultorioId);
    }

    // ============================================================
    //  /sesiones/{sesionId}
    // ============================================================
    function sesionSplitEsCoherente(data) {
      let calculado = data.valorTotal * data.porcentajeConsultorio / 100;
      return data.montoConsultorio >= calculado - 1
          && data.montoConsultorio <= calculado + 1
          && data.montoProfesional == data.valorTotal - data.montoConsultorio;
    }

    function sesionTieneCamposBasicos(data) {
      return data.consultorioId is string
          && data.profesionalUid is string
          && data.pacienteId is string
          && data.metodoPagoId is string
          && data.valorTotal is number
          && data.valorTotal >= 0
          && data.porcentajeConsultorio is number
          && data.porcentajeConsultorio >= 0
          && data.porcentajeConsultorio <= 100
          && data.montoConsultorio is number
          && data.montoProfesional is number;
    }

    function profesionalTieneConfianza() {
      return esProfesional()
        && miUsuario().permitirEdicionSesiones == true;
    }

    match /sesiones/{sesionId} {
      allow read: if esSuperadmin()
        || esAdminDe(resource.data.consultorioId)
        || (esProfesionalDe(resource.data.consultorioId)
            && resource.data.profesionalUid == request.auth.uid);

      allow create: if (esSuperadmin()
        || esAdminDe(request.resource.data.consultorioId)
        || (profesionalTieneConfianza()
            && esProfesionalDe(request.resource.data.consultorioId)
            && request.resource.data.profesionalUid == request.auth.uid))
        && request.resource.data.estadoPago == 'debido'
        && sesionTieneCamposBasicos(request.resource.data)
        && sesionSplitEsCoherente(request.resource.data);

      allow update: if (esSuperadmin()
        || esAdminDe(resource.data.consultorioId)
        || (profesionalTieneConfianza()
            && esProfesionalDe(resource.data.consultorioId)
            && resource.data.profesionalUid == request.auth.uid
            && request.resource.data.profesionalUid == resource.data.profesionalUid
            && request.resource.data.consultorioId == resource.data.consultorioId
            && request.resource.data.estadoPago == resource.data.estadoPago))
        && sesionTieneCamposBasicos(request.resource.data)
        && sesionSplitEsCoherente(request.resource.data);

      allow delete: if esSuperadmin()
        || esAdminDe(resource.data.consultorioId)
        || (profesionalTieneConfianza()
            && esProfesionalDe(resource.data.consultorioId)
            && resource.data.profesionalUid == request.auth.uid);
    }

    // ============================================================
    //  /solicitudes_sesion/{solicitudId}
    // ============================================================
    match /solicitudes_sesion/{solicitudId} {

      allow read: if esSuperadmin()
        || esAdminDe(resource.data.consultorioId)
        || esProfesionalDe(resource.data.consultorioId);

      allow create: if esProfesionalDe(request.resource.data.consultorioId)
        && request.resource.data.profesionalUid == request.auth.uid
        && request.resource.data.estado == 'pendiente'
        && (request.resource.data.tipo == 'crear'
            || request.resource.data.tipo == 'modificar'
            || request.resource.data.tipo == 'eliminar');

      allow update: if esSuperadmin()
        || (esAdminDe(resource.data.consultorioId)
            && request.resource.data.consultorioId == resource.data.consultorioId
            && request.resource.data.profesionalUid == resource.data.profesionalUid
            && request.resource.data.tipo == resource.data.tipo
            && (request.resource.data.estado == 'aprobada'
                || request.resource.data.estado == 'rechazada'
                || request.resource.data.estado == 'obsoleta'));

      allow delete: if esSuperadmin();
    }

    // ============================================================
    //  /logs_sesion/{logId}
    // ============================================================
    match /logs_sesion/{logId} {

      allow read: if esSuperadmin()
        || esAdminDe(resource.data.consultorioId)
        || esProfesionalDe(resource.data.consultorioId);

      allow create: if estaAutenticado()
        && request.resource.data.actorUid == request.auth.uid
        && (esSuperadmin()
            || esAdminDe(request.resource.data.consultorioId)
            || esProfesionalDe(request.resource.data.consultorioId));

      allow update: if false;
      allow delete: if esSuperadmin();
    }

    // ============================================================
    //  /pagos_consultorio/{pagoId}
    // ============================================================
    match /pagos_consultorio/{pagoId} {
      allow read: if esSuperadmin()
        || esAdminDe(resource.data.consultorioId)
        || (esProfesionalDe(resource.data.consultorioId)
            && resource.data.profesionalUid == request.auth.uid);

      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ============================================================
    //  /pagos_mensualidad/{pagoId}
    // ============================================================
    match /pagos_mensualidad/{pagoId} {
      allow read: if esSuperadmin()
        || esAdminDe(resource.data.consultorioId);
      allow write: if false;
    }

    // ============================================================
    //  /config/{docId}
    // ============================================================
    match /config/{docId} {
      allow read: if estaAutenticado();
      allow write: if esSuperadmin();
    }

    // ============================================================
    //  /oauth_states/{state}
    // ============================================================
    match /oauth_states/{state} {
      allow read, write: if false;
    }

    // ============================================================
    //  Todo lo demas: bloqueado.
    // ============================================================
  }
}
