rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    //  Helpers
    // ============================================================
    function estaAutenticado() {
      return request.auth != null;
    }

    function miUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function tengoDoc() {
      return estaAutenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function esSuperadmin() {
      return tengoDoc() && miUsuario().rol == 'superadmin';
    }

    function esAdmin() {
      return tengoDoc() && miUsuario().rol == 'admin';
    }

    function esCoadmin() {
      return tengoDoc() && miUsuario().rol == 'coadmin';
    }

    function esProfesional() {
      return tengoDoc() && miUsuario().rol == 'profesional';
    }

    function esAdminDe(consultorioIdDelRecurso) {
      return esAdmin()
        && miUsuario().consultorioId == consultorioIdDelRecurso
        && request.auth.uid in get(/databases/$(database)/documents/consultorios/$(consultorioIdDelRecurso)).data.adminUids;
    }

    function esCoadminDe(consultorioIdDelRecurso) {
      return esCoadmin() && miUsuario().consultorioId == consultorioIdDelRecurso;
    }

    // Staff del consultorio: admin o coadmin del mismo consultorio.
    // Se usa para todas las operaciones operativas (sesiones, pacientes,
    // logs, recordatorios, etc). El coadmin tiene los mismos permisos
    // de operacion que el admin; solo se diferencia en que no participa
    // del reparto de dinero (eso se maneja por feature, no por rules).
    //
    // IMPORTANTE: para tocar el array adminUids del consultorio o
    // promover/demover roles en /usuarios, se sigue exigiendo esAdminDe()
    // estricto. Esos son los unicos casos donde el coadmin NO equivale
    // al admin.
    function esStaffDe(consultorioIdDelRecurso) {
      return esAdminDe(consultorioIdDelRecurso)
        || esCoadminDe(consultorioIdDelRecurso);
    }

    function esProfesionalDe(consultorioIdDelRecurso) {
      return esProfesional() && miUsuario().consultorioId == consultorioIdDelRecurso;
    }

    function esDueno(uid) {
      return estaAutenticado() && request.auth.uid == uid;
    }

    function intentaEscalarPrivilegios() {
      return request.resource.data.rol != resource.data.rol
        || request.resource.data.consultorioId != resource.data.consultorioId;
    }

    function campoNoCambia(name) {
      return (
        (!(name in request.resource.data) && !(name in resource.data))
        || (name in request.resource.data && name in resource.data
            && request.resource.data[name] == resource.data[name])
      );
    }

    // ============================================================
    //  /usuarios/{uid}
    // ============================================================
    match /usuarios/{uid} {

      // Read: superadmin, dueno, o staff del mismo consultorio.
      // El coadmin necesita leer la lista de profesionales y los datos
      // de cualquier miembro del consultorio para que la UI funcione.
      allow read: if esSuperadmin()
        || esDueno(uid)
        || ((esAdmin() || esCoadmin()) && resource.data.consultorioId == miUsuario().consultorioId);

      allow create: if esDueno(uid)
        && request.resource.data.rol == 'profesional'
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.consultorioId == null;

      // Update: superadmin, admin del consultorio (cualquier campo),
      // coadmin del consultorio (sin tocar rol/consultorioId), o el
      // propio dueno con sus propias restricciones.
      // La promocion entre roles SOLO la puede hacer el admin estricto
      // (no el coadmin) para evitar que un coadmin se autopromueva.
      allow update: if esSuperadmin()
        || (esAdmin()
            && resource.data.consultorioId == miUsuario().consultorioId
            && request.resource.data.rol == resource.data.rol
            && request.resource.data.consultorioId == resource.data.consultorioId)
        // Coadmin: puede editar campos operativos de miembros del consultorio
        // (permisos, displayName, etc.) PERO no puede tocar rol ni
        // consultorioId — esos quedan reservados al admin.
        || (esCoadmin()
            && resource.data.consultorioId == miUsuario().consultorioId
            && request.resource.data.rol == resource.data.rol
            && request.resource.data.consultorioId == resource.data.consultorioId
            && request.auth.uid != uid)
        // Promocion / democion entre 'profesional' y 'admin' / 'coadmin'
        // por parte de otro ADMIN del mismo consultorio.
        || (esAdmin()
            && resource.data.consultorioId == miUsuario().consultorioId
            && request.resource.data.consultorioId == resource.data.consultorioId
            && request.resource.data.estado == resource.data.estado
            && resource.data.rol in ['profesional', 'admin', 'coadmin']
            && request.resource.data.rol in ['profesional', 'admin', 'coadmin']
            && request.auth.uid != uid)
        || (esDueno(uid)
            && !intentaEscalarPrivilegios()
            && request.resource.data.estado == resource.data.estado)
        || (esDueno(uid)
            && !intentaEscalarPrivilegios()
            && resource.data.estado == 'activo'
            && request.resource.data.estado == 'retirado')
        || (esDueno(uid)
            && resource.data.rol == 'profesional'
            && resource.data.consultorioId == null
            && request.resource.data.rol == 'admin'
            && request.resource.data.consultorioId != null
            && request.resource.data.estado == 'activo')
        || (esDueno(uid)
            && resource.data.rol == 'profesional'
            && resource.data.consultorioId == null
            && request.resource.data.rol == 'profesional'
            && request.resource.data.consultorioId != null
            && request.resource.data.estado == 'activo');

      allow delete: if esSuperadmin();
    }

    // ============================================================
    //  /consultorios/{consultorioId}
    // ============================================================
    match /consultorios/{consultorioId} {

      // Read: superadmin, staff del consultorio (admin o coadmin), o
      // profesional del consultorio. El coadmin necesita leer el doc
      // del consultorio para que funcione la pagina de Configuracion,
      // los metodos de pago, etc.
      allow read: if esSuperadmin()
        || ((esAdmin() || esCoadmin()) && miUsuario().consultorioId == consultorioId)
        || (esProfesional() && miUsuario().consultorioId == consultorioId);

      allow create: if estaAutenticado()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.adminUids == [request.auth.uid]
        && request.resource.data.plan == 'free'
        && request.resource.data.estado == 'activo';

      /*
        Update del consultorio.

        - SUPERADMIN puede tocar cualquier cosa.
        - ADMIN del consultorio: edita campos basicos y puede modificar
          adminUids / ownerUid (transferencia de ownership).
        - COADMIN del consultorio: edita campos basicos PERO no puede
          tocar adminUids, ownerUid ni los campos blindados (plan,
          comisiones, MP config, etc).

        Campos siempre blindados (admin tampoco los puede tocar; solo
        superadmin / backend):
           - plan, planVenceEn
           - comisionConsulpay, comisionFree, comisionPro, comisionUltra
           - puedeVerPlanPro, puedeVerPlanUltra
           - mpIntegrado, mpConfig, ualaIntegrado, ualaConfig
           - mpConfigs, repartoActivado, repartoIniciaEn, repartoActivadoEn
           - estado, subscription
      */
      allow update: if esSuperadmin()
        || (esAdminDe(consultorioId)
            && campoNoCambia('plan')
            && campoNoCambia('planVenceEn')
            && campoNoCambia('comisionConsulpay')
            && campoNoCambia('comisionFree')
            && campoNoCambia('comisionPro')
            && campoNoCambia('comisionUltra')
            && campoNoCambia('puedeVerPlanPro')
            && campoNoCambia('puedeVerPlanUltra')
            && campoNoCambia('subscription')
            && campoNoCambia('mpConfigs')
            && campoNoCambia('repartoActivado')
            && campoNoCambia('repartoIniciaEn')
            && campoNoCambia('repartoActivadoEn')
            && campoNoCambia('mpIntegrado')
            && campoNoCambia('mpConfig')
            && campoNoCambia('ualaIntegrado')
            && campoNoCambia('ualaConfig')
            && campoNoCambia('estado')
            && (
              (request.resource.data.ownerUid == resource.data.ownerUid
                && request.resource.data.ownerUid in request.resource.data.adminUids
                && request.resource.data.adminUids.size() >= 1
                && request.resource.data.adminUids.size() <= 2)
              ||
              (resource.data.ownerUid == request.auth.uid
                && request.resource.data.ownerUid in request.resource.data.adminUids
                && request.resource.data.adminUids.size() >= 1
                && request.resource.data.adminUids.size() <= 2)
            ))
        // Coadmin: mismas restricciones que admin EXCEPTO que tampoco
        // puede tocar adminUids ni ownerUid (esos son responsabilidad
        // del admin / owner).
        || (esCoadminDe(consultorioId)
            && campoNoCambia('plan')
            && campoNoCambia('planVenceEn')
            && campoNoCambia('comisionConsulpay')
            && campoNoCambia('comisionFree')
            && campoNoCambia('comisionPro')
            && campoNoCambia('comisionUltra')
            && campoNoCambia('puedeVerPlanPro')
            && campoNoCambia('puedeVerPlanUltra')
            && campoNoCambia('subscription')
            && campoNoCambia('mpConfigs')
            && campoNoCambia('repartoActivado')
            && campoNoCambia('repartoIniciaEn')
            && campoNoCambia('repartoActivadoEn')
            && campoNoCambia('mpIntegrado')
            && campoNoCambia('mpConfig')
            && campoNoCambia('ualaIntegrado')
            && campoNoCambia('ualaConfig')
            && campoNoCambia('estado')
            && campoNoCambia('adminUids')
            && campoNoCambia('ownerUid'));

      allow delete: if esSuperadmin();

      // Compensaciones: solo backend escribe; staff lee.
      match /compensaciones/{idCiclo} {
        allow read: if esSuperadmin() || esStaffDe(consultorioId);
        allow write: if false;
      }
    }

    // ============================================================
    //  /invitaciones_profesional/{invitacionId}
    // ------------------------------------------------------------
    //  'get' queda abierto a proposito: el link que llega por mail se
    //  abre SIN sesion iniciada, y /aceptar-invitacion necesita leer la
    //  invitacion por ID antes de que la persona se registre o entre.
    //
    //  'list' va cerrado. Con un 'read' unico (get + list) cualquiera,
    //  incluso sin autenticarse, podia enumerar la coleccion entera y
    //  llevarse los mails, los nombres, los consultorios y el
    //  porcentaje negociado de cada profesional invitado.
    //
    //  Los tres casos legitimos de listado:
    //    - el superadmin,
    //    - el staff, que lista las invitaciones de su consultorio,
    //    - el propio invitado, que busca la suya por email desde
    //      /pendiente cuando ya inicio sesion.
    // ============================================================
    match /invitaciones_profesional/{invitacionId} {

      allow get: if true;

      allow list: if esSuperadmin()
        || esStaffDe(resource.data.consultorioId)
        || (estaAutenticado() && request.auth.token.email == resource.data.email);

      allow create: if false;

      allow update: if esSuperadmin()
        || esStaffDe(resource.data.consultorioId)
        || (estaAutenticado()
            && request.auth.token.email == resource.data.email
            && request.resource.data.estado == 'aceptada');

      allow delete: if esSuperadmin() || esStaffDe(resource.data.consultorioId);
    }

    // ============================================================
    //  /pacientes/{pacienteId}
    // ============================================================
    match /pacientes/{pacienteId} {
      allow read: if esSuperadmin()
        || esStaffDe(resource.data.consultorioId)
        || (esProfesionalDe(resource.data.consultorioId)
            && request.auth.uid in resource.data.profesionalesUids);

      allow create: if esSuperadmin()
        || esStaffDe(request.resource.data.consultorioId);

      allow update: if (esSuperadmin() || esStaffDe(resource.data.consultorioId))
        && request.resource.data.consultorioId == resource.data.consultorioId;

      allow delete: if esSuperadmin() || esStaffDe(resource.data.consultorioId);
    }

    // ============================================================
    //  /sesiones/{sesionId}
    // ============================================================
    function sesionSplitEsCoherente(data) {
      let calculado = data.valorTotal * data.porcentajeConsultorio / 100;
      return data.montoConsultorio >= calculado - 1
          && data.montoConsultorio <= calculado + 1
          && data.montoProfesional == data.valorTotal - data.montoConsultorio;
    }

    function sesionTieneCamposBasicos(data) {
      return data.consultorioId is string
          && data.profesionalUid is string
          && data.pacienteId is string
          && data.metodoPagoId is string
          && data.valorTotal is number
          && data.valorTotal >= 0
          && data.porcentajeConsultorio is number
          && data.porcentajeConsultorio >= 0
          && data.porcentajeConsultorio <= 100
          && data.montoConsultorio is number
          && data.montoProfesional is number;
    }

    function sesionPendienteMontoValida(data) {
      return data.estadoPago == 'pendiente_monto'
          && data.valorTotal == 0
          && data.montoConsultorio == 0
          && data.montoProfesional == 0;
    }

    function profesionalTieneConfianza() {
      return esProfesional()
        && miUsuario().permitirEdicionSesiones == true;
    }

    match /sesiones/{sesionId} {
      allow read: if esSuperadmin()
        || esStaffDe(resource.data.consultorioId)
        || (esProfesionalDe(resource.data.consultorioId)
            && resource.data.profesionalUid == request.auth.uid);

      allow create: if (esSuperadmin()
        || esStaffDe(request.resource.data.consultorioId)
        || (profesionalTieneConfianza()
            && esProfesionalDe(request.resource.data.consultorioId)
            && request.resource.data.profesionalUid == request.auth.uid))
        && sesionTieneCamposBasicos(request.resource.data)
        && (
          (request.resource.data.estadoPago == 'debido'
            && sesionSplitEsCoherente(request.resource.data))
          ||
          sesionPendienteMontoValida(request.resource.data)
        );

      allow update: if (esSuperadmin()
        || esStaffDe(resource.data.consultorioId)
        || (profesionalTieneConfianza()
            && esProfesionalDe(resource.data.consultorioId)
            && resource.data.profesionalUid == request.auth.uid
            && request.resource.data.profesionalUid == resource.data.profesionalUid
            && request.resource.data.consultorioId == resource.data.consultorioId
            && campoNoCambia('receptorUid')
            && campoNoCambia('receptorNombre')
            && campoNoCambia('fechaPago')
            && (request.resource.data.estadoPago == resource.data.estadoPago
                || (resource.data.estadoPago == 'pendiente_monto'
                    && request.resource.data.estadoPago == 'debido'))))
        && sesionTieneCamposBasicos(request.resource.data)
        && (
          (request.resource.data.estadoPago == 'debido'
            && sesionSplitEsCoherente(request.resource.data))
          ||
          (request.resource.data.estadoPago == 'pagado'
            && sesionSplitEsCoherente(request.resource.data))
          ||
          sesionPendienteMontoValida(request.resource.data)
        );

      allow delete: if esSuperadmin()
        || esStaffDe(resource.data.consultorioId)
        || (profesionalTieneConfianza()
            && esProfesionalDe(resource.data.consultorioId)
            && resource.data.profesionalUid == request.auth.uid);
    }

    // ============================================================
    //  /citas/{citaId} — agenda del consultorio
    // ------------------------------------------------------------
    //  Solo se usa en el modelo de reparto "recepcion_cobra": la
    //  recepcion (admin o coadmin) maneja la agenda y el profesional
    //  la consulta en modo lectura.
    //
    //  IMPORTANTE sobre el read del profesional: la condicion
    //  profesionalUid == uid obliga a que el cliente filtre por ese
    //  campo EN EL QUERY. Firestore evalua las reglas contra la
    //  consulta y no contra los resultados: pedir todas las citas del
    //  consultorio para filtrarlas en memoria se rechaza entero.
    // ============================================================
    match /citas/{citaId} {

      allow read: if esSuperadmin()
        || esStaffDe(resource.data.consultorioId)
        || (esProfesionalDe(resource.data.consultorioId)
            && resource.data.profesionalUid == request.auth.uid);

      // Solo el staff agenda. El profesional nunca crea ni edita turnos.
      allow create: if esStaffDe(request.resource.data.consultorioId)
        && request.resource.data.consultorioId is string
        && request.resource.data.profesionalUid is string
        && request.resource.data.pacienteNombre is string
        && request.resource.data.fecha is string
        && request.resource.data.hora is string
        && request.resource.data.duracionMin is number
        && request.resource.data.estado in ['agendada', 'asistio', 'ausente', 'cancelada'];

      allow update: if esStaffDe(resource.data.consultorioId)
        && request.resource.data.consultorioId == resource.data.consultorioId
        && request.resource.data.estado in ['agendada', 'asistio', 'ausente', 'cancelada'];

      allow delete: if esStaffDe(resource.data.consultorioId);
    }

    // ============================================================
    //  /series_citas/{serieId} — regla de repeticion de un turno fijo
    // ------------------------------------------------------------
    //  Guarda la configuracion de la serie (cada cuanto, hasta cuando).
    //  Las citas concretas viven en /citas; esto es solo la receta, y
    //  la maneja unicamente el staff.
    // ============================================================
    match /series_citas/{serieId} {

      allow read: if esSuperadmin() || esStaffDe(resource.data.consultorioId);

      allow create: if esStaffDe(request.resource.data.consultorioId)
        && request.resource.data.consultorioId is string
        && request.resource.data.profesionalUid is string
        && request.resource.data.desde is string;

      allow update: if esStaffDe(resource.data.consultorioId)
        && request.resource.data.consultorioId == resource.data.consultorioId;

      allow delete: if esStaffDe(resource.data.consultorioId);
    }

    // ============================================================
    //  /solicitudes_sesion/{solicitudId}
    // ============================================================
    match /solicitudes_sesion/{solicitudId} {

      allow read: if esSuperadmin()
        || esStaffDe(resource.data.consultorioId)
        || esProfesionalDe(resource.data.consultorioId);

      allow create: if esProfesionalDe(request.resource.data.consultorioId)
        && request.resource.data.profesionalUid == request.auth.uid
        && request.resource.data.estado == 'pendiente'
        && (request.resource.data.tipo == 'crear'
            || request.resource.data.tipo == 'modificar'
            || request.resource.data.tipo == 'eliminar'
            || request.resource.data.tipo == 'liquidar_monto'
            || request.resource.data.tipo == 'carga_rapida'
            || request.resource.data.tipo == 'crear_paciente'
            || request.resource.data.tipo == 'marcar_pagada'
            || request.resource.data.tipo == 'liquidar_os');

      allow update: if esSuperadmin()
        || (esStaffDe(resource.data.consultorioId)
            && request.resource.data.consultorioId == resource.data.consultorioId
            && request.resource.data.profesionalUid == resource.data.profesionalUid
            && request.resource.data.tipo == resource.data.tipo
            && (request.resource.data.estado == 'aprobada'
                || request.resource.data.estado == 'rechazada'
                || request.resource.data.estado == 'obsoleta'));

      allow delete: if esSuperadmin();
    }

    // ============================================================
    //  /logs_sesion/{logId}
    // ============================================================
    match /logs_sesion/{logId} {

      allow read: if esSuperadmin()
        || esStaffDe(resource.data.consultorioId)
        || esProfesionalDe(resource.data.consultorioId);

      allow create: if estaAutenticado()
        && request.resource.data.actorUid == request.auth.uid
        && (esSuperadmin()
            || esStaffDe(request.resource.data.consultorioId)
            || esProfesionalDe(request.resource.data.consultorioId));

      allow update: if false;
      allow delete: if esSuperadmin();
    }

    // ============================================================
    //  /pagos_consultorio/{pagoId}
    // ============================================================
    match /pagos_consultorio/{pagoId} {
      allow read: if esSuperadmin()
        || esStaffDe(resource.data.consultorioId)
        || (esProfesionalDe(resource.data.consultorioId)
            && resource.data.profesionalUid == request.auth.uid);

      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ============================================================
    //  /pagos_mensualidad/{pagoId}
    // ============================================================
    match /pagos_mensualidad/{pagoId} {
      allow read: if esSuperadmin()
        || esStaffDe(resource.data.consultorioId);
      allow write: if false;
    }

    // ============================================================
    //  /config/{docId}
    // ============================================================
    match /config/{docId} {
      allow read: if estaAutenticado();
      allow write: if esSuperadmin();
    }

    // ============================================================
    //  /oauth_states/{state}
    // ============================================================
    match /oauth_states/{state} {
      allow read, write: if false;
    }

    // ============================================================
    //  /recordatorios/{recordatorioId}
    // ============================================================
    match /recordatorios/{recordatorioId} {
      allow read: if esSuperadmin()
        || esStaffDe(resource.data.consultorioId)
        || (esProfesionalDe(resource.data.consultorioId)
            && request.auth.uid in resource.data.destinatarios)
        || (esProfesionalDe(resource.data.consultorioId)
            && resource.data.creadoPorUid == request.auth.uid);

      allow create: if esSuperadmin()
        || esStaffDe(request.resource.data.consultorioId)
        || (esProfesionalDe(request.resource.data.consultorioId)
            && request.resource.data.creadoPorUid == request.auth.uid
            && request.resource.data.destinatarios == [request.auth.uid]);

      allow update: if esSuperadmin()
        || esStaffDe(resource.data.consultorioId)
        || (esProfesionalDe(resource.data.consultorioId)
            && resource.data.creadoPorUid == request.auth.uid);

      allow delete: if esSuperadmin()
        || esStaffDe(resource.data.consultorioId)
        || (esProfesionalDe(resource.data.consultorioId)
            && resource.data.creadoPorUid == request.auth.uid);
    }

    // ============================================================
    //  /recordatorios_instancias/{instanciaId}
    // ============================================================
    match /recordatorios_instancias/{instanciaId} {
      allow read: if esSuperadmin()
        || esStaffDe(resource.data.consultorioId)
        || (esProfesionalDe(resource.data.consultorioId)
            && resource.data.profesionalUid == request.auth.uid);

      allow create: if esSuperadmin()
        || esStaffDe(request.resource.data.consultorioId)
        || esProfesionalDe(request.resource.data.consultorioId);

      allow update: if esSuperadmin()
        || esStaffDe(resource.data.consultorioId)
        || (esProfesionalDe(resource.data.consultorioId)
            && resource.data.profesionalUid == request.auth.uid);

      allow delete: if esSuperadmin()
        || esStaffDe(resource.data.consultorioId);
    }

    // ============================================================
    //  Todo lo demas: bloqueado.
    // ============================================================
  }
}
